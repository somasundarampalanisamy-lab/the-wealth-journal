{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface", "color": "#F5F6F8" },
				{ "slug": "line", "name": "Line", "color": "#E4E7EC" },
				{ "slug": "muted", "name": "Muted text", "color": "#4A5568" },
				{ "slug": "ink-soft", "name": "Body text", "color": "#3A4556" },
				{ "slug": "ink", "name": "Ink", "color": "#0F1B2D" },
				{ "slug": "starting", "name": "Starting Out", "color": "#0E7364" },
				{ "slug": "starting-soft", "name": "Starting Out (tint)", "color": "#E7F2F0" },
				{ "slug": "growing", "name": "Growing", "color": "#2B4FD8" },
				{ "slug": "growing-soft", "name": "Growing (tint)", "color": "#EAEEFC" },
				{ "slug": "building", "name": "Building Wealth", "color": "#6B2E83" },
				{ "slug": "building-soft", "name": "Building Wealth (tint)", "color": "#F2EBF5" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 6vw, 4rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3.5rem, 8vw, 6rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.3125rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "huge", "name": "Huge", "size": "4.25rem", "fluid": { "min": "2.5rem", "max": "4.25rem" } }
			],
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Bricolage Grotesque",
					"fontFamily": "\"Bricolage Grotesque\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/bricolage-grotesque-latin-standard-normal.woff2" ],
							"unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"
						},
						{
							"fontFamily": "Bricolage Grotesque",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/bricolage-grotesque-latin-ext-standard-normal.woff2" ],
							"unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF"
						}
					]
				},
				{
					"slug": "body",
					"name": "IBM Plex Sans",
					"fontFamily": "\"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-400-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-ext-400-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-400-italic.woff2" ] },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-500-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-ext-500-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-600-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-ext-600-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-700-normal.woff2" ], "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" },
						{ "fontFamily": "IBM Plex Sans", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/ibm-plex-sans-latin-ext-700-normal.woff2" ], "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" }
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|ink" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|growing" } },
				":focus": { "color": { "text": "var:preset|color|growing" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|ink" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.08", "letterSpacing": "-0.025em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"button": {
				"color": { "background": "var:preset|color|ink", "text": "var:preset|color|base" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" } },
				"typography": { "fontFamily": "var:preset|font-family|body", "fontWeight": "600", "fontSize": "0.9375rem", "lineHeight": "1.3" },
				":hover": { "color": { "background": "#24344D", "text": "var:preset|color|base" } },
				":focus": { "color": { "background": "#24344D", "text": "var:preset|color|base" } }
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var:preset|font-family|display", "fontWeight": "700", "fontSize": "1.375rem", "letterSpacing": "-0.01em" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem", "fontWeight": "500" },
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-title": {
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|ink", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } },
				"typography": { "fontSize": "var:preset|font-size|large", "fontStyle": "normal" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|line" }
			},
			"core/table": {
				"typography": { "fontSize": "0.9375rem" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title (hub pages)", "postTypes": [ "page" ] }
	]
}
